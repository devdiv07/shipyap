# TRUSTED PUBLISHER ONLY. Never copy into the drafting workspace or give to a model or coding agent.
# This file is documentation and is never loaded automatically. Set variables only in your user
# environment for `pros review` and `pros run` (from a password manager), never in a file,
# VS Code settings, CI or this repository:
#   PowerShell: $env:PROS_BUFFER_API_KEY = "..."
#
# The one Buffer credential. Only publication/buffer.py reads it (a test enforces that).
# Create a key on a Buffer account/channel you own; it is sent only to https://api.buffer.com.
PROS_BUFFER_API_KEY=
# Publishing is OFF unless this is exactly the lowercase word `false`. Unset, empty, `true`, `0`,
# `False` and anything else keep it off. Without it, `pros review` still lets you read, edit and
# approve, but offers no scheduling.
PUBLISHING_DISABLED=true
# Not read by this project and not needed: BUFFER_API_KEY (the old placeholder name).
